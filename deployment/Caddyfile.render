{
    admin off
}

:{$PORT} {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        # 只在上游没给缓存策略时才兜底 no-store；否则会把
        # 带 ?v= 的静态资源的长缓存覆盖掉（并产生重复头）。
        ?Cache-Control no-store
    }

    # The full workbench is always the root page, including on iPad. The
    # lightweight capture companion remains available explicitly at
    # /mobile.html. API credentials stay in the Render environment.
    #
    # The self-hosted sync API authenticates with Bearer tokens, so its
    # Authorization header must survive the proxy. Everything else keeps
    # stripping it.
    @sync path /api/sync/*
    handle @sync {
        reverse_proxy unix//tmp/studio.sock {
            header_up Host localhost
        }
    }
    handle {
        reverse_proxy unix//tmp/studio.sock {
            header_up Host localhost
            header_up -Authorization
        }
    }
}
