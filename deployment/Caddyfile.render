{
    admin off
}

:{$PORT} {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Cache-Control no-store
    }

    # The full workbench is always the root page, including on iPad. The
    # lightweight capture companion remains available explicitly at
    # /mobile.html. API credentials stay in the Render environment.
    reverse_proxy unix//tmp/studio.sock {
        header_up Host localhost
        header_up -Authorization
    }
}
