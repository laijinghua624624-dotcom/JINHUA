# 站点地址：IP 测试用 :80；有域名后改成 lance.你的域名.com
SITE_ADDR=:80
# 对外访问地址：IP 测试用 http://服务器IP；有域名后改成 https://lance.你的域名.com
PUBLIC_URL=http://服务器IP
# 允许的 Host（可逗号分隔）
ALLOWED_HOSTS=服务器IP

# 从本机 .env 复制这些密钥（不要提交到 GitHub）
DEEPSEEK_API_KEY=
DEEPSEEK_DIRECTOR_MODEL=deepseek-v4-pro
DEEPSEEK_REFINE_MODEL=deepseek-flash
ARK_API_KEY=
ARK_DIRECTOR_MODEL=
ARK_REFINE_MODEL=
ARK_IMAGE_MODEL=
ARK_VIDEO_MODEL=
ARK_EMBEDDING_MODEL=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=
PINTEREST_ACCESS_TOKEN=
SPEECH_APP_ID=
SPEECH_ACCESS_TOKEN=
SPEECH_RESOURCE_ID=volc.seedasr.auc
