{$SITE_ADDR} {
	encode gzip

	# 手机打卡 / 报销上传：公开，靠项目专属链接隔离（现场群直接用，不弹密码）
	@checkin_public path /m /form /expense /supplier /supplier.js /supplier.css /style.css /form.js /expense.js /photos/* /api/meta /api/submit /api/expense/submit /api/supplier/submit
	handle @checkin_public {
		reverse_proxy checkin:8137
	}

	# 打卡后台 / 导出：要密码
	@checkin_admin path /admin /admin.js /api/submissions /api/expenses /api/expense/* /api/expenses/* /api/submission/* /api/export.csv /api/supplier/submissions /api/supplier/delete /api/supplier/imported /archives/* /api/archive/* /api/catalog /api/catalog/*
	handle @checkin_admin {
		basic_auth {
			lance {$LANCE_PASSWORD_HASH}
			laiJH {$SHARE_PASSWORD_HASH}
		}
		reverse_proxy checkin:8137
	}

	# 自托管同步 API：公开路由，由应用层 Bearer 令牌鉴权（不能套 basic_auth）
	@sync path /api/sync/*
	handle @sync {
		reverse_proxy lance:10000
	}

	# 手机随身版：公开页面；收件箱/工作台数据仍由 Supabase 登录保护
	# 雷达只放行公开数据接口；radar-preview 在服务端有域名白名单，不是开放代理
	@mobile path /mobile.html /mobile.js /mobile.css /mobile-sw.js /mobile.webmanifest /mobile-config.js /mobile-icon.svg /mobile-icon-180.png /mobile-icon-192.png /mobile-icon-512.png /studio-cloud.js /studio-cloud-vps.js /studio-radar.js /api/radar-feed /api/radar-preview
	handle @mobile {
		reverse_proxy lance:10000
	}

	# 工作台 UI 公开：只有一个自建云登录；报价、媒体、后台和普通 API 仍要站点密码
	@private path /quote /quote/* /media/* /admin* /api/* /deliverables/*
	handle @private {
		basic_auth {
			lance {$LANCE_PASSWORD_HASH}
			laiJH {$SHARE_PASSWORD_HASH}
		}
		reverse_proxy lance:10000
	}

	# 其余页面（工作台首页等）：分享出去也要登录；手机版/供应商页已在上面放行
	handle {
		basic_auth {
			lance {$LANCE_PASSWORD_HASH}
			laiJH {$SHARE_PASSWORD_HASH}
		}
		reverse_proxy lance:10000
	}
}
