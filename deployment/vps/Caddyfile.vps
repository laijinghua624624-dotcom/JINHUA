{$SITE_ADDR} {
	encode gzip

	# 手机打卡 / 报销上传：公开，靠项目专属链接隔离（现场群直接用，不弹密码）
	@checkin_public path /m /form /expense /style.css /form.js /expense.js /photos/* /api/meta /api/submit /api/expense/submit
	handle @checkin_public {
		reverse_proxy checkin:8137
	}

	# 打卡后台 / 导出：要密码
	@checkin_admin path /admin /admin.js /api/submissions /api/expenses /api/expense/* /api/expenses/* /api/submission/* /api/export.csv
	handle @checkin_admin {
		basic_auth {
			lance {$LANCE_PASSWORD_HASH}
		}
		reverse_proxy checkin:8137
	}

	# 工作台 + 报价系统：要密码
	handle {
		basic_auth {
			lance {$LANCE_PASSWORD_HASH}
		}
		reverse_proxy lance:10000
	}
}
