# 复制为 .env 后填写；.env 已被 Git 忽略。
# 新版工作台使用方舟 Ark；模型必须已在你的账户开通。
ARK_API_KEY=
# 内容总监：填写控制台确认的 Doubao-Seed-2.1-pro Model ID / Endpoint ID
ARK_DIRECTOR_MODEL=
# 日常灵感提炼：Doubao-Seed-2.1-turbo，未配置时明确报错，不暗中换模型
ARK_REFINE_MODEL=
# 兼容既有环境：仅当 ARK_DIRECTOR_MODEL 为空时读取旧的 ARK_TEXT_MODEL
ARK_TEXT_MODEL=
# 快速视觉：Seedream-5.0-lite
ARK_IMAGE_MODEL=
# 动态预演：Seedance-2.0-fast
ARK_VIDEO_MODEL=
# 审美语义检索：Doubao-embedding-vision
ARK_EMBEDDING_MODEL=

# 豆包录音文件识别 2.0：新版控制台填 SPEECH_API_KEY；旧版用 App ID + Access Token
SPEECH_API_KEY=
SPEECH_APP_ID=
SPEECH_ACCESS_TOKEN=
SPEECH_RESOURCE_ID=volc.seedasr.auc
# 可选：只在控制台明确要求时填具体 model_version
SPEECH_MODEL_VERSION=

# 以下仅用于独立的旧版即梦代理；新版不需要，未使用请保持空白。
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=

# 多个来源用英文逗号分隔。本地预览和当前 GitHub Pages 地址已在代理中提供默认值。
JIMENG_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://laijinghua624624-dotcom.github.io
JIMENG_PROXY_HOST=127.0.0.1
JIMENG_PROXY_PORT=8765
