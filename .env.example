# 复制为 .env 后填写；.env 已被 Git 忽略。
# 新版工作台使用方舟 Ark；模型必须已在你的账户开通。
ARK_API_KEY=
ARK_TEXT_MODEL=
ARK_IMAGE_MODEL=
ARK_VIDEO_MODEL=

# 以下仅用于保留的旧版即梦代理。
VOLC_ACCESS_KEY_ID=your-access-key-id
VOLC_SECRET_ACCESS_KEY=your-secret-access-key

# 多个来源用英文逗号分隔。本地预览和当前 GitHub Pages 地址已在代理中提供默认值。
JIMENG_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://laijinghua624624-dotcom.github.io
JIMENG_PROXY_HOST=127.0.0.1
JIMENG_PROXY_PORT=8765
