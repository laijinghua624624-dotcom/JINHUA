{
  "name": "Lance 随身创意",
  "short_name": "Lance随身",
  "description": "每天查看选题雷达，也可记录语音、文字、图片和链接，回到 Mac 后进入 JINHUA 深加工。",
  "start_url": "./mobile.html",
  "scope": "./",
  "share_target": {
    "action": "./mobile.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "display": "standalone",
  "background_color": "#10130f",
  "theme_color": "#151914",
  "icons": [
    {
      "src": "mobile-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "mobile-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "mobile-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "id": "./mobile.html",
  "orientation": "portrait",
  "lang": "zh-CN"
}
